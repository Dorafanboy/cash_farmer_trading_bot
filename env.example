# ОКРУЖЕНИЕ (по умолчанию development)
APP_ENV=development

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_DEBUG=true

# SOLANA
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# JITO
JITO_RPC_URL=https://amsterdam.mainnet.block-engine.jito.wtf/api/v1
